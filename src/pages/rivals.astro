---
import Layout from "../layouts/Layout.astro";
import { TEAMS, DIVISIONS } from "../lib/teams.js";

const byDivision = DIVISIONS.map((d) => ({
  name: d,
  teams: Object.entries(TEAMS).filter(([, t]) => t[1] === d).sort((a, b) => a[1][0].localeCompare(b[1][0])),
}));
---

<Layout title="HOCKEI · Rivals" activePage="rivals">
  <div class="sec" style="margin-top:26px">
    <div style="display:flex;justify-content:space-between;align-items:end;gap:16px;flex-wrap:wrap">
      <p class="deck" style="margin:0">Pick the teams you love to hate.</p>
      <div style="display:flex;gap:18px;align-items:center">
        <span class="mono" id="count" aria-live="polite"></span>
        <button type="button" class="navlink" id="clear" style="background:none;border:0;cursor:pointer;padding:0">Clear all</button>
        <a class="navlink" href="/" style="color:var(--ink)">Done</a>
      </div>
    </div>
    <div class="divs">
      {byDivision.map((d) => (
        <section aria-labelledby={`d-${d.name}`}>
          <h2 class="kick" id={`d-${d.name}`}>{d.name}</h2>
          {d.teams.map(([ab, t]) => (
            <button type="button" class="pick" data-team={ab} aria-pressed="false" style={`--c:${t[2]}`}>
              <span class="sw"></span><span class="nm">{t[0]}</span><span class="ab">{ab}</span>
            </button>
          ))}
        </section>
      ))}
    </div>
  </div>
</Layout>

<script>
  import { getSelectedRivals, toggleRival, clearAllRivals } from "../lib/store.js";

  const picks = [...document.querySelectorAll<HTMLButtonElement>(".pick")];
  function sync(sel: Set<string>) {
    picks.forEach((b) => b.setAttribute("aria-pressed", String(sel.has(b.dataset.team!))));
    document.getElementById("count")!.textContent = sel.size ? `${sel.size} ${sel.size === 1 ? "rival" : "rivals"}` : "No rivals yet";
    window.dispatchEvent(new Event("rivals-changed"));
  }
  picks.forEach((b) => b.addEventListener("click", () => sync(toggleRival(b.dataset.team!))));
  document.getElementById("clear")!.addEventListener("click", () => sync(clearAllRivals()));
  sync(getSelectedRivals());
</script>
